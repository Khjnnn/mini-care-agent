# FHIR server (docker compose up -d → HAPI FHIR R4)
FHIR_BASE_URL=http://localhost:8080/fhir

# Any OpenAI-compatible endpoint: vLLM, Ollama, OpenAI, LiteLLM gateway ...
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_API_KEY=EMPTY

# Agents / platform
AGENTS_DIR=agents
MEMORY_PATH=.data/memory.sqlite3
# PLUGINS=my_team.tools,other_team.skills

# Route through the PHI-aware router instead of a single LLM_BASE_URL
# ROUTER_CONFIG=deploy/router.example.yaml

# Langfuse (self-hosted inside the trust boundary)
# LANGFUSE_HOST=http://langfuse.internal:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
